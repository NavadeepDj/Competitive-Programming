import operator

ops = {
    '+': operator.add,
    '-': operator.sub,
    '*': operator.mul,
    '/': operator.floordiv,  # or truediv for float
    '%': operator.mod
}

a = int(input())
b = int(input())
op = input()

if op in ops:
    print(f"Result: {ops[op](a, b)}")
else:
    print("Invalid operator")
